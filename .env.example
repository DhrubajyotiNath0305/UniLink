# Pooled connection used by the app at runtime.
# On Neon this is the URL ending in "-pooler.<region>.aws.neon.tech".
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Unpooled connection used by `drizzle-kit` and the destructive API e2e suite.
# A transaction mode pooler cannot hold a session open for the length of a
# migration, so this must point straight at the database.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional. "require" skips TLS certificate verification, for providers that
# present a self-signed chain. "disable" turns TLS off for a local socket.
# DATABASE_SSL=require

# Optional. Connection pool ceiling. Defaults to 10 in production, 3 in dev.
# DATABASE_POOL_MAX=10

# Required. HS256 signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Destructive API e2e tests (`npm run test:api`) refuse to run unless
# API_TEST_ALLOW_LIVE is "1", because they create and delete real records.
# Set API_TEST_ALLOW_LOCAL=1 as well to waive the loud banner when the target
# is a throwaway database on localhost.
# API_TEST_ALLOW_LIVE=1
# API_TEST_ALLOW_LOCAL=1
